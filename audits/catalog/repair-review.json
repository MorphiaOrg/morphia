  "exclusionCategories": [
    {
      "name": "NON_OPERATOR",
      "description": "The documentation directory entry is not an operator.",
      "resolution": "Keep excluded; drop when the capability catalog stops listing it."
    },
    {
      "name": "ENVIRONMENT_UNAVAILABLE",
      "description": "Requires Atlas Search/Vector Search, which the test environment does not provide.",
      "resolution": "Reevaluate when an Atlas-capable test environment and Morphia support exist."
    },
    {
      "name": "POLICY_EXCLUSION",
      "description": "Deliberately outside Morphia's scope: administrative/diagnostic stages, deprecated aliases or operators judged ill-suited to an ODM.",
      "resolution": "Reevaluate on a user request or a change in Morphia's support policy."
    },
    {
      "name": "TESTED_ELSEWHERE",
      "description": "Covered by handwritten tests instead of documentation fixtures.",
      "resolution": "Keep while those tests exist; reconcile when generation covers the operator."
    },
    {
      "name": "DEFERRED",
      "description": "Excluded without a recorded rationale.",
      "resolution": "Needs a reviewed rationale or support decision before the next capability report."
    }
  ],
