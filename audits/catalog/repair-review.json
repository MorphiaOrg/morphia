{
  "schemaVersion": 1,
  "categories": [
    {
      "name": "EXTRACTION",
      "description": "The legacy extractor took the wrong block, mangled or truncated text, kept exposition or per-stage output, or needed manual extraction.",
      "resolution": "Retire when the pinned scenario extractor produces an equivalent scenario natively."
    },
    {
      "name": "SHELL_SYNTAX",
      "description": "Shell source the legacy JSON parser could not read: helper constructors, inline variables, arithmetic, timestamps, index text, broken punctuation.",
      "resolution": "Retire when shell normalization lowers the source to the same typed BSON."
    },
    {
      "name": "MORPHIA_FORM",
      "description": "Morphia generates an equivalent but differently shaped or ordered command: short $cond/$eq forms, field order, _id placement, argument layout.",
      "resolution": "Replace with a declared, reviewed command-equivalence rule or Morphia compatibility decision."
    },
    {
      "name": "NUMERIC_TYPE",
      "description": "Numeric values changed type or precision to match Java/BSON typing or server results.",
      "resolution": "Retire when typed BSON comparison proves the documented values; otherwise keep as a typed override."
    },
    {
      "name": "DOCS_ERROR",
      "description": "The upstream documentation's data or results are wrong or inconsistent.",
      "resolution": "Keep as a reviewed correction pinned to the source digest; re-check when upstream changes."
    },
    {
      "name": "FIXTURE_CURATION",
      "description": "Test data or expectations adjusted so the example is executable and deterministic: renamed collections, added or filtered data, predictable ids, prior-example state.",
      "resolution": "Keep as an explicit setup or expectation override in the scenario manifest."
    },
    {
      "name": "UNTESTABLE",
      "description": "The example cannot run in this harness (for example a change-stream watch loop).",
      "resolution": "Keep as a scoped exemption with reevaluation criteria."
    }
  ],
