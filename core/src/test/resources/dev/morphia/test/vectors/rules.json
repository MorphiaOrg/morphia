                "pattern": "p",
                "options": ""
              }
            },
            "$options": "i"
          }
        }
      ],
      "canonical": "{\"v\": [{\"a\": {\"$regex\": \"p\", \"$options\": \"im\"}, \"b\": {\"$regex\": \"p\", \"$options\": \"im\"}, \"c\": {\"$regex\": \"p\", \"$options\": \"i\"}}]}"
    },
