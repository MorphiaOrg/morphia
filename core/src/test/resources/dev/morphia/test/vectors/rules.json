                "options": ""
              }
            }
          }
        }
      ],
      "canonical": "{\"v\": [{\"name\": {\"$eq\": {\"$regularExpression\": {\"pattern\": \"^a\", \"options\": \"\"}}}}]}"
    },
    {
      "name": "regex forms",
      "shape": "FIND",
      "rules": [
        "REGEX_FORM"
      ],
      "input": [
        {
          "a": {
            "$regularExpression": {
              "pattern": "p",
              "options": "im"
            }
          },
          "b": {
            "#regex": "p",
            "#options": "im"
          },
          "c": {
            "$regex": {
