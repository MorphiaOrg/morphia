    "blob": "85387638087f90e9e6ee786098da61bf83b88a0a"
  },
  "dataset": null,
  "collections": {
    "grades": [
      {
        "student_id": {
          "$numberInt": "457864153"
        },
        "class_id": "01",
        "class_desc": "Algebra",
        "grade": "A"
      },
      {
        "student_id": {
          "$numberInt": "457864153"
        },
        "class_id": "02",
        "class_desc": "Chemistry",
        "grade": {
          "$numberInt": "3"
        }
      },
      {
        "student_id": {
          "$numberInt": "978451637"
        },
        "class_id": "03",
        "class_desc": "Physics",
        "grade": "C"
      },
      {
        "student_id": {
          "$numberInt": "978451637"
        },
        "class_id": "04",
        "class_desc": "English",
        "grade": {
          "$numberInt": "4"
        }
      }
    ]
  },
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "grades",
    "pipeline": [
      {
        "$addFields": {
          "points": {
            "$cond": {
              "if": {
                "$isNumber": "$grade"
              },
              "then": "$grade",
              "else": {
                "$switch": {
                  "branches": [
                    {
                      "case": {
                        "$eq": [
                          "$grade",
                          "A"
                        ]
                      },
                      "then": {
                        "$numberInt": "4"
                      }
                    },
                    {
                      "case": {
                        "$eq": [
                          "$grade",
                          "B"
                        ]
                      },
                      "then": {
                        "$numberInt": "3"
                      }
                    },
                    {
                      "case": {
                        "$eq": [
                          "$grade",
                          "C"
                        ]
                      },
                      "then": {
                        "$numberInt": "2"
                      }
                    },
                    {
                      "case": {
                        "$eq": [
                          "$grade",
                          "D"
                        ]
                      },
                      "then": {
                        "$numberInt": "1"
                      }
                    },
                    {
                      "case": {
                        "$eq": [
                          "$grade",
                          "F"
                        ]
                      },
                      "then": {
                        "$numberInt": "0"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      {
        "$group": {
          "_id": "$student_id",
          "GPA": {
            "$avg": "$points"
          }
        }
      }
    ]
  },
  "expected": {
    "printed": [
      {
        "document": [
          {
            "name": "_id",
