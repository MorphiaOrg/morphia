  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "metacritic": {
            "$gt": {
              "$numberInt": "85"
            }
          },
          "year": {
            "$gte": {
              "$numberInt": "1993"
            },
            "$lte": {
              "$numberInt": "1995"
            }
          }
        }
      },
      {
        "$project": {
          "_id": {
            "$numberInt": "0"
          },
          "title": {
            "$numberInt": "1"
          },
          "released": {
            "$numberInt": "1"
          },
          "runtime": {
            "$numberInt": "1"
          }
        }
      },
      {
        "$setWindowFields": {
          "partitionBy": {
            "$year": "$released"
          },
          "sortBy": {
            "released": {
              "$numberInt": "1"
            }
          },
          "output": {
            "cumulativeRuntimeForYear": {
              "$sum": "$runtime",
              "window": {
                "documents": [
                  "unbounded",
                  "current"
                ]
              }
            },
            "maximumRuntimeForYear": {
              "$max": "$runtime",
              "window": {
                "documents": [
                  "unbounded",
                  "unbounded"
                ]
              }
            }
          }
        }
      }
    ]
  },
