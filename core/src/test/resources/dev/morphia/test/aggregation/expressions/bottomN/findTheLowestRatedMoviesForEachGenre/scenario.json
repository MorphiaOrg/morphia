      },
      {
        "$match": {
          "imdb.rating": {
            "$exists": true
          }
        }
      },
      {
        "$group": {
          "_id": "$genres",
          "lowestRatedMovie": {
            "$bottomN": {
              "output": [
                "$title",
                "$imdb.rating"
              ],
              "sortBy": {
                "imdb.rating": {
                  "$numberInt": "-1"
                },
                "title": {
                  "$numberInt": "1"
                }
              },
              "n": {
                "$numberInt": "3"
              }
            }
          }
        }
      },
      {
        "$sort": {
          "_id": {
            "$numberInt": "1"
          }
        }
      },
      {
        "$limit": {
          "$numberInt": "5"
        }
      }
    ]
  },
