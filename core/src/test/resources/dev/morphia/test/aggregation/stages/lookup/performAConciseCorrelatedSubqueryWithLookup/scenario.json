    "collection": "orders",
    "pipeline": [
      {
        "$lookup": {
          "from": "restaurants",
          "localField": "restaurant_name",
          "foreignField": "name",
          "let": {
            "orders_drink": "$drink"
          },
          "pipeline": [
            {
              "$match": {
                "$expr": {
                  "$in": [
