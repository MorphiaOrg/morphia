                        },
                        {
                          "$size": "$pages"
                        }
                      ]
                    }
                  ]
                }
              },
              "as": "pageWithIndex",
              "cond": {
                "$let": {
                  "vars": {
                    "page": {
                      "$arrayElemAt": [
                        "$$pageWithIndex",
                        {
                          "$numberInt": "0"
                        }
                      ]
                    }
                  },
                  "in": {
                    "$gte": [
                      "$$page.reviews",
                      {
                        "$numberInt": "1"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "expected": {
