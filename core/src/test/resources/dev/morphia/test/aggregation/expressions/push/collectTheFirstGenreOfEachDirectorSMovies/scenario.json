  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "year": {
            "$gte": {
              "$numberInt": "2010"
            },
            "$lte": {
              "$numberInt": "2015"
            }
          },
          "genres": {
            "$exists": true,
            "$ne": []
          },
          "directors": {
            "$exists": true,
            "$ne": []
          }
        }
      },
      {
        "$unwind": "$directors"
      },
      {
        "$group": {
          "_id": "$directors",
          "genres": {
            "$push": {
              "$first": "$genres"
            }
          }
        }
      },
      {
        "$sort": {
          "_id": {
            "$numberInt": "1"
          }
        }
      },
      {
        "$limit": {
          "$numberInt": "5"
        }
      }
    ]
  },
