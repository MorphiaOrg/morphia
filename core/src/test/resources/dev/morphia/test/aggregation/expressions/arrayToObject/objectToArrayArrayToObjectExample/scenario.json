  },
  "dataset": null,
  "collections": {
    "inventory": [
      {
        "_id": {
          "$numberInt": "1"
        },
        "item": "ABC1",
        "instock": {
          "warehouse1": {
            "$numberInt": "2500"
          },
          "warehouse2": {
            "$numberInt": "500"
          }
        }
      },
      {
        "_id": {
          "$numberInt": "2"
        },
        "item": "ABC2",
        "instock": {
          "warehouse2": {
            "$numberInt": "500"
          },
          "warehouse3": {
            "$numberInt": "200"
          }
        }
      }
    ]
  },
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "inventory",
    "pipeline": [
      {
        "$addFields": {
          "instock": {
            "$objectToArray": "$instock"
          }
        }
      },
      {
        "$addFields": {
          "instock": {
            "$concatArrays": [
              "$instock",
              [
                {
                  "k": "total",
                  "v": {
                    "$sum": "$instock.v"
                  }
                }
              ]
            ]
          }
        }
      },
      {
        "$addFields": {
          "instock": {
            "$arrayToObject": "$instock"
          }
        }
      }
    ]
  },
  "expected": {
    "printed": [
      {
