  "dataset": null,
  "collections": {
    "inventory": [
      {
        "_id": {
          "$numberInt": "1"
        },
        "item": "ABC1",
        "instock": {
          "warehouse1": {
            "$numberInt": "2500"
          },
          "warehouse2": {
            "$numberInt": "500"
          }
        }
      },
      {
        "_id": {
          "$numberInt": "2"
        },
        "item": "ABC2",
        "instock": {
          "warehouse2": {
            "$numberInt": "500"
          },
          "warehouse3": {
            "$numberInt": "200"
          }
        }
      }
    ]
  },
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "inventory",
    "pipeline": [
      {
        "$project": {
          "warehouses": {
            "$objectToArray": "$instock"
          }
        }
      },
      {
        "$unwind": "$warehouses"
      },
      {
        "$group": {
          "_id": "$warehouses.k",
          "total": {
            "$sum": "$warehouses.v"
          }
        }
      }
    ]
  },
