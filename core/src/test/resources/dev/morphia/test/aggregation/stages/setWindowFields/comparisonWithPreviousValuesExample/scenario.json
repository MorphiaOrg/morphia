  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "cakeSales",
    "pipeline": [
      {
        "$setWindowFields": {
          "partitionBy": "$type",
          "sortBy": {
            "orderDate": {
              "$numberInt": "1"
            }
          },
          "output": {
            "previousPrice": {
              "$shift": {
                "output": "$price",
                "by": {
                  "$numberInt": "-1"
                }
              }
            }
          }
        }
      },
      {
        "$set": {
          "priceComparison": {
            "$cond": [
              {
                "$eq": [
                  "$price",
                  "$previousPrice"
                ]
              },
              "same",
              {
                "$cond": [
                  {
                    "$gt": [
                      "$price",
                      "$previousPrice"
                    ]
                  },
                  "higher",
                  "lower"
                ]
              }
            ]
          }
        }
      }
    ]
  },
