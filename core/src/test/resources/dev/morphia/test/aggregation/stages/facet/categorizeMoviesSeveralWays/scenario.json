                    }
                  },
                  "titles": {
                    "$push": "$title"
                  }
                }
              }
            }
          ],
          "categorizedByYear(Auto)": [
            {
              "$bucketAuto": {
                "groupBy": "$year",
                "buckets": {
                  "$numberInt": "4"
                }
              }
            }
          ]
        }
      }
    ]
