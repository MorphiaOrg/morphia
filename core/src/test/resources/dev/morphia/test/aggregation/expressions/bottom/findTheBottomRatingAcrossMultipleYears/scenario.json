{
  "schemaVersion": {
    "$numberInt": "1"
  },
  "name": "aggregation/expressions/bottom/findTheBottomRatingAcrossMultipleYears",
  "title": "Find the Bottom Rating Across Multiple Years",
  "context": "EXPRESSION",
  "source": {
    "repository": "mongodb/docs",
    "commit": "e4b0c153a0f39829bb1c2e5195beee1e92a8eff7",
    "path": "content/manual/manual/source/reference/operator/aggregation/bottom.txt",
    "blob": "09c132aa13207d6184617e20e2867a2505304562"
  },
  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "imdb.rating": {
            "$exists": true
          },
          "year": {
            "$gte": {
              "$numberInt": "2010"
            },
            "$lte": {
              "$numberInt": "2012"
            }
          }
        }
      },
      {
        "$group": {
          "_id": "$year",
          "lowestRatedMovie": {
            "$bottom": {
              "output": [
                "$title",
                "$imdb.rating"
              ],
              "sortBy": {
                "imdb.rating": {
                  "$numberInt": "-1"
                }
              }
            }
          }
        }
      },
      {
        "$sort": {
          "_id": {
            "$numberInt": "1"
          }
        }
      }
    ]
  },
  "expected": {
    "printed": [
      {
        "document": [
          {
            "name": "_id",
            "value": {
              "whole": {
                "$numberInt": "2010"
              }
            }
          },
          {
            "name": "lowestRatedMovie",
            "value": {
              "array": [
                {
                  "text": "Khan the Con"
                },
                {
                  "exact": {
                    "$numberDouble": "2.5"
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "document": [
          {
            "name": "_id",
            "value": {
              "whole": {
                "$numberInt": "2011"
              }
            }
          },
          {
            "name": "lowestRatedMovie",
            "value": {
              "array": [
                {
                  "text": "Justin Bieber: Never Say Never"
                },
                {
                  "exact": {
                    "$numberDouble": "1.6"
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "document": [
          {
            "name": "_id",
            "value": {
              "whole": {
                "$numberInt": "2012"
              }
            }
          },
          {
            "name": "lowestRatedMovie",
            "value": {
              "array": [
                {
                  "text": "USS Seaviper"
                },
                {
                  "exact": {
                    "$numberDouble": "2.5"
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "comparison": {
    "order": "UNORDERED",
    "rules": [
      "FIELD_OPERATORS_AND",
      "NAMED_ARGUMENTS"
    ],
    "ignore": [],
    "tolerance": null
  },
  "requirements": {
    "minimumServer": "5.2.0",
    "topology": "STANDALONE"
  },
