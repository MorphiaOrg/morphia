  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "orders",
    "pipeline": [
      {
        "$lookup": {
          "from": "warehouses",
          "let": {
            "order_item": "$item",
            "order_qty": "$ordered"
          },
          "pipeline": [
            {
              "$match": {
                "$expr": {
                  "$and": [
