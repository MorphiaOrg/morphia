              }
            }
          }
        }
      ],
      "canonical": "{\"v\": [{\"$match\": {\"a\": {\"$numberInt\": \"1\"}, \"n\": {\"$regex\": \"^x\", \"$options\": \"is\"}}}]}"
    },
    {
      "name": "unionWith pipeline",
      "shape": "PIPELINE",
      "rules": [
        "COND_ARRAY",
        "NAMED_ARGUMENTS"
      ],
      "input": [
        {
          "$unionWith": {
            "pipeline": [
              {
                "$project": {
                  "c": {
                    "$cond": {
                      "if": {
                        "$numberInt": "1"
                      },
                      "then": {
                        "$numberInt": "2"
                      },
                      "else": {
                        "$numberInt": "3"
                      }
                    }
                  }
                }
              }
            ],
            "coll": "o"
          }
        }
      ],
      "canonical": "{\"v\": [{\"$unionWith\": {\"pipeline\": [{\"$project\": {\"c\": {\"$cond\": [{\"$numberInt\": \"1\"}, {\"$numberInt\": \"2\"}, {\"$numberInt\": \"3\"}]}}}], \"coll\": \"o\"}}]}"
    },
    {
      "name": "projection flags in a project stage",
      "shape": "PIPELINE",
      "rules": [
        "PROJECTION_FLAGS"
      ],
      "input": [
        {
          "$project": {
            "a": true,
            "_id": false
          }
        }
      ],
      "canonical": "{\"v\": [{\"$project\": {\"a\": {\"$numberInt\": \"1\"}, \"_id\": {\"$numberInt\": \"0\"}}}]}"
    },
    {
      "name": "eq with an empty document collapses",
      "shape": "FIND",
      "rules": [
        "EQ_SHORTHAND"
      ],
      "input": [
        {
          "f": {
            "$eq": {}
          }
        }
      ],
      "canonical": "{\"v\": [{\"f\": {}}]}"
