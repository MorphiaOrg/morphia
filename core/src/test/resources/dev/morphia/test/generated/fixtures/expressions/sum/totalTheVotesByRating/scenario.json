  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "rated": {
            "$in": [
              "G",
              "PG",
              "PG-13",
              "R"
            ]
          },
          "imdb.votes": {
            "$type": "int"
          }
        }
      },
      {
        "$group": {
          "_id": "$rated",
          "totalVotes": {
            "$sum": "$imdb.votes"
          }
        }
      },
      {
        "$sort": {
          "_id": {
            "$numberInt": "1"
          }
        }
      }
    ]
  },
