  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "rated": {
            "$in": [
              "G",
              "PG",
              "PG-13",
              "R"
            ]
          },
          "imdb.rating": {
            "$exists": true
          }
        }
      },
      {
        "$group": {
          "_id": {
            "rated": "$rated"
          },
          "movies": {
            "$bottomN": {
              "output": {
                "title": "$title",
                "rating": "$imdb.rating"
              },
              "n": {
                "$cond": {
                  "if": {
                    "$eq": [
                      "$rated",
                      "PG"
                    ]
                  },
                  "then": {
                    "$numberInt": "3"
                  },
                  "else": {
                    "$numberInt": "1"
                  }
                }
              },
              "sortBy": {
                "imdb.rating": {
                  "$numberInt": "-1"
                }
              }
            }
          }
        }
      },
      {
        "$sort": {
          "_id.rated": {
            "$numberInt": "1"
          }
        }
      }
    ]
  },
