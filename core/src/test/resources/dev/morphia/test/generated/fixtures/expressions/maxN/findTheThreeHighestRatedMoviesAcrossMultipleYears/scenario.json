  },
  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "year": {
            "$in": [
              {
                "$numberInt": "1999"
              },
              {
                "$numberInt": "2000"
              },
              {
                "$numberInt": "2001"
              }
            ]
          },
          "imdb.rating": {
            "$exists": true
          }
        }
      },
      {
        "$group": {
          "_id": "$year",
          "topThreeRatings": {
            "$maxN": {
              "input": "$imdb.rating",
              "n": {
                "$numberInt": "3"
              }
            }
          }
        }
      },
      {
        "$sort": {
          "_id": {
            "$numberInt": "1"
          }
        }
      }
    ]
  },
