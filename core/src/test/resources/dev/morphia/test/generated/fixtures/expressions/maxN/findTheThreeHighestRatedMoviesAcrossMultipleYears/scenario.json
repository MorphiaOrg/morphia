  "name": "aggregation/expressions/maxN/findTheThreeHighestRatedMoviesAcrossMultipleYears",
  "title": "Find the Three Highest Rated Movies Across Multiple Years",
  "context": "EXPRESSION",
  "source": {
    "repository": "mongodb/docs",
    "commit": "e4b0c153a0f39829bb1c2e5195beee1e92a8eff7",
