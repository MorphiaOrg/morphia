  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "directors": {
            "$exists": true
          },
          "imdb.rating": {
            "$type": "double"
          }
        }
      },
      {
        "$unwind": "$directors"
      },
      {
        "$group": {
          "_id": "$directors",
          "movieCount": {
            "$sum": {
              "$numberInt": "1"
            }
          },
          "stdDevSampRating": {
            "$stdDevSamp": "$imdb.rating"
          }
        }
      },
      {
        "$match": {
          "movieCount": {
            "$gte": {
              "$numberInt": "10"
            }
          }
        }
      },
      {
        "$sort": {
          "stdDevSampRating": {
            "$numberInt": "-1"
          }
        }
      },
      {
        "$limit": {
          "$numberInt": "5"
        }
      }
    ]
  },
