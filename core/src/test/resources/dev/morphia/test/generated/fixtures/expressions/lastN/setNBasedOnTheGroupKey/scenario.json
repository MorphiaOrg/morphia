    "blob": "98dafefa7632bb0e385d2997600ec03d4e304ae7"
  },
  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "rated": {
            "$in": [
              "G",
              "PG",
              "PG-13",
              "R"
            ]
          },
          "year": {
            "$type": "int"
          },
          "title": {
            "$regex": "^[A-Za-z0-9]"
          }
        }
      },
      {
        "$sort": {
          "title": {
            "$numberInt": "1"
          }
        }
      },
      {
        "$group": {
          "_id": {
            "rated": "$rated"
          },
          "movies": {
            "$lastN": {
              "input": "$title",
              "n": {
                "$cond": {
                  "if": {
                    "$eq": [
                      "$rated",
                      "PG"
                    ]
                  },
                  "then": {
                    "$numberInt": "3"
                  },
                  "else": {
                    "$numberInt": "1"
                  }
                }
              }
            }
          }
        }
      },
      {
        "$sort": {
          "_id.rated": {
            "$numberInt": "1"
          }
        }
      }
    ]
  },
