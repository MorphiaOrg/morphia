{
  "schemaVersion": {
    "$numberInt": "1"
  },
  "name": "aggregation/expressions/bottomN/findTheThreeLowestRatedMoviesInASingleGenre",
  "title": "Find the Three Lowest Rated Movies in a Single Genre",
  "context": "EXPRESSION",
  "source": {
    "repository": "mongodb/docs",
    "commit": "e4b0c153a0f39829bb1c2e5195beee1e92a8eff7",
    "path": "content/manual/manual/source/reference/operator/aggregation/bottomN.txt",
    "blob": "e889d2a459bf25885175611a49408f65c55394f4"
  },
  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "genres": "Short",
          "imdb.rating": {
            "$exists": true
          }
        }
      },
      {
        "$group": {
          "_id": "Short",
          "lowestRatedMovies": {
            "$bottomN": {
              "output": [
                "$title",
                "$imdb.rating"
              ],
              "sortBy": {
                "imdb.rating": {
                  "$numberInt": "-1"
                },
                "title": {
                  "$numberInt": "1"
                }
              },
              "n": {
                "$numberInt": "3"
              }
            }
          }
        }
      }
    ]
  },
  "expected": {
    "printed": [
      {
        "document": [
          {
            "name": "_id",
            "value": {
              "text": "Short"
            }
          },
          {
            "name": "lowestRatedMovies",
            "value": {
              "array": [
                {
                  "array": [
                    {
                      "text": "Andrè and Wally B."
                    },
                    {
                      "exact": {
                        "$numberDouble": "5.4"
                      }
                    }
                  ]
                },
                {
                  "array": [
                    {
                      "text": "The Education of Mohammad Hussein"
                    },
                    {
                      "exact": {
                        "$numberDouble": "5.4"
                      }
                    }
                  ]
                },
                {
                  "array": [
                    {
                      "text": "Enigma"
                    },
                    {
                      "exact": {
                        "$numberDouble": "5.3"
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "comparison": {
    "order": "UNORDERED",
    "rules": [
      "EQ_SHORTHAND",
      "NAMED_ARGUMENTS"
    ],
    "ignore": [],
    "tolerance": null
  },
  "requirements": {
    "minimumServer": null,
    "topology": "STANDALONE"
  },
  "skipped": {
    "results": "the example queries the sample_mflix sample dataset, which the tests do not load"
  }
}
