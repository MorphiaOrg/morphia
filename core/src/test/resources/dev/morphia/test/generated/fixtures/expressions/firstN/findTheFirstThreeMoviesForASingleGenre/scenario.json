  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "aggregate",
    "collection": "movies",
    "pipeline": [
      {
        "$match": {
          "genres": "Horror"
        }
      },
      {
        "$sort": {
          "year": {
            "$numberInt": "1"
          }
        }
      },
      {
        "$group": {
          "_id": "Horror",
          "firstThreeMovies": {
            "$firstN": {
              "input": [
                "$title",
                "$year"
              ],
              "n": {
                "$numberInt": "3"
              }
            }
          }
        }
      }
    ]
  },
