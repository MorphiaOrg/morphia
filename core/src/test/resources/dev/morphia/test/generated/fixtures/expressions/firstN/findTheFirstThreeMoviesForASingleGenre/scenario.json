            "value": {
              "array": [
                {
                  "array": [
                    {
                      "text": "Dr. Jekyll and Mr. Hyde"
                    },
                    {
                      "whole": {
                        "$numberInt": "1931"
                      }
                    }
                  ]
                },
                {
                  "array": [
                    {
                      "text": "Dracula"
                    },
                    {
                      "whole": {
