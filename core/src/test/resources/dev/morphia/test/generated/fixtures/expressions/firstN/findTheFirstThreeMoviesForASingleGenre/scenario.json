  "name": "aggregation/expressions/firstN/findTheFirstThreeMoviesForASingleGenre",
  "title": "Find the First Three Movies for a Single Genre",
  "context": "EXPRESSION",
  "source": {
    "repository": "mongodb/docs",
    "commit": "e4b0c153a0f39829bb1c2e5195beee1e92a8eff7",
