  "name": "query/filters/expr/useExprWithConditionalStatements",
  "title": "Use $expr With Conditional Statements",
  "context": "FILTER",
  "source": {
    "repository": "mongodb/docs",
    "commit": "e4b0c153a0f39829bb1c2e5195beee1e92a8eff7",
