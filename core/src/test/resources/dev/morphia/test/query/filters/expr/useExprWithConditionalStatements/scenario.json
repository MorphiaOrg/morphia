  "dataset": "sample_mflix",
  "collections": {},
  "indexes": [],
  "action": {
    "kind": "find",
    "collection": "movies",
    "filter": {
      "imdb.rating": {
        "$type": "number"
      },
      "imdb.votes": {
        "$type": "number"
      },
      "$expr": {
        "$gt": [
          {
            "$cond": {
              "if": {
                "$gte": [
                  "$imdb.votes",
                  {
                    "$numberInt": "1000"
                  }
                ]
              },
              "then": {
                "$multiply": [
                  "$imdb.rating",
                  {
                    "$numberInt": "1"
                  }
                ]
              },
              "else": {
                "$multiply": [
                  "$imdb.rating",
                  {
                    "$numberDouble": "0.5"
                  }
                ]
              }
            }
          },
          {
            "$numberInt": "9"
          }
        ]
      }
    },
    "projection": {
      "_id": {
        "$numberInt": "0"
      },
      "title": {
        "$numberInt": "1"
      },
      "imdb.rating": {
        "$numberInt": "1"
      },
      "imdb.votes": {
        "$numberInt": "1"
      }
    },
    "options": {
      "sort": {
        "title": {
          "$numberInt": "1"
        }
      },
      "limit": {
        "$numberInt": "5"
      }
    }
  },
